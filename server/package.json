{
  "name": "providence-admin-server",
  "version": "1.0.0",
  "description": "Providence Admin Backend Service",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:reset": "prisma migrate reset --force",
    "seed": "node prisma/seed.js",
    "setup": "npm run prisma:generate && npm run prisma:migrate && npm run seed",
    "lint": "eslint src/ --fix"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "express": "^4.21.1"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "prisma": "^5.22.0"
  },
  "keywords": [
    "admin",
    "backend",
    "api"
  ],
  "author": "Providence Team",
  "license": "proprietary"
}
